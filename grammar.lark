start: statements

statements: statements command
        | command

command: forwardCommand
        | rotateCommand
        | liftPenCommand
        | downPenCommand
        | changeColorCommand
        | repeatCommand

forwardCommand:    
        "forward" NUMBER

rotateCommand:
        "rotate"  NUMBER

liftPenCommand:
        "penup"

downPenCommand:    
        "pendown"

changeColorCommand: 
        "color"  COLOR

repeatCommand:
        "repeat"  INT "{" statements "}"


COLOR: /[a-zA-Z]+/
%import common.NUMBER
%import common.INT
%import common.WS
%ignore WS
%ignore /\#[^\n]*/